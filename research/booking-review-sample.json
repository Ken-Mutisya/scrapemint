          "editUrl": null,
          "positiveHighlights": null,
          "partnerReply": {
            "__typename": "PropertyReplyData",
            "reply": "Hello Roy,\n\nThank you for taking the time to share your feedback. I am glad to hear that you enjoyed our location and found our staff to be welcoming during your stay.\n\nI am sorry to hear that other aspects of your experience did not meet expectations. Your comments regarding room acoustics, the condition of the elevators, and the shower experience are appreciated and will be shared with our teams for review. Feedback like this helps us identify areas where we can continue to improve.\n\nThank you again for staying with us and for sharing your thoughts.\n\nWarm Regards,\n\nDAVID SPILLANE\nDIRECTOR OF ROOMS & SAFETY\nACE HOTEL NEW YORK"
          },
          "photos": null,
