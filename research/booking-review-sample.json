          "negativeHighlights": null,
          "positiveHighlights": null,
          "partnerReply": {
            "reply": "Hello Katherine,\n\nThank you so much for the great review. I’m thrilled to hear you loved the location, our team, and the unique vibe of the rooms.\n\nIt’s also great to know you enjoyed the lobby as a place to connect, along with the coffee shop and bar, those spaces are such a big part of the Ace experience.\n\nWe truly appreciate you staying with us and hope to welcome you back again soon.\n\nWarm Regards,\n\nDAVID SPILLANE\nDIRECTOR OF ROOMS & SAFETY\nACE HOTEL NEW YORK",
            "__typename": "PropertyReplyData"
          },
          "photos": null
        },
        {
          "reviewedDate": 1775136433,
          "textDetails": {
            "__typename": "TextDetails",
